# MarktPilot Backend — example environment file
# Copy to `.env` and edit as needed. App loads via os.environ (no dotenv lib required).

# SQLite-Datei (relativ zum backend/-Verzeichnis)
DATABASE_URL=sqlite:///./markt_pilot.db

# CORS — für Development offen, in Production einschränken
CORS_ALLOW_ORIGINS=*

# Server
HOST=0.0.0.0
PORT=8000